{
  "name": "literature-manager-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.2.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.local.literaturemanager",
    "productName": "Literature Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "Frontend/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/backend/LiteratureManagerBackend.exe",
        "to": "backend/LiteratureManagerBackend.exe"
      }
    ],
    "win": {
      "target": "zip"
    }
  }
}
